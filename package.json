{
  "name": "taskcircuit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "taskcircuit": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --pool=threads --maxWorkers=1",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:codex": "npm run build && node scripts/e2e.mjs codex",
    "test:e2e:claude": "npm run build && node scripts/e2e.mjs claude"
  },
  "dependencies": {
    "fastify": "^5.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "vitest": "^5.1.0"
  }
}
